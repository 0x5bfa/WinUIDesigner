<Project>
	<PropertyGroup>
		<LangVersion>preview</LangVersion>
		<Nullable>enable</Nullable>
		<Deterministic>true</Deterministic>
		<WinUIDesignerSurfaceTargetFramework Condition="'$(WinUIDesignerSurfaceTargetFramework)' == '' and $([MSBuild]::VersionGreaterThanOrEquals('$(MSBuildVersion)', '18.0'))">net10.0-windows10.0.19041.0</WinUIDesignerSurfaceTargetFramework>
		<WinUIDesignerSurfaceTargetFramework Condition="'$(WinUIDesignerSurfaceTargetFramework)' == ''">net8.0-windows10.0.19041.0</WinUIDesignerSurfaceTargetFramework>
	</PropertyGroup>
</Project>
