<Page
    x:Class="WinUIDesignerSampleApp.ConditionalXamlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cond="using:WinUIDesignerSampleApp.Conditions"
    xmlns:contract7NotPresent="http://schemas.microsoft.com/winfx/2006/xaml/presentation?IsApiContractNotPresent(Windows.Foundation.UniversalApiContract,7)"
    xmlns:contract7Present="http://schemas.microsoft.com/winfx/2006/xaml/presentation?IsApiContractPresent(Windows.Foundation.UniversalApiContract,7)"
    xmlns:contract99NotPresent="http://schemas.microsoft.com/winfx/2006/xaml/presentation?IsApiContractNotPresent(Windows.Foundation.UniversalApiContract,99)"
    xmlns:contract99Present="http://schemas.microsoft.com/winfx/2006/xaml/presentation?IsApiContractPresent(Windows.Foundation.UniversalApiContract,99)"
    xmlns:legacyMode="http://schemas.microsoft.com/winfx/2006/xaml/presentation?cond:FeatureFlagCondition(LegacyMode)"
    xmlns:newExperience="http://schemas.microsoft.com/winfx/2006/xaml/presentation?cond:FeatureFlagCondition(NewExperience)">
    <Page.Resources>
        <!--  Conditional setters: the heading is semi-bold because contract 7 is present, and not red.  -->
        <Style x:Key="ConditionalHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <contract7Present:Setter Property="FontWeight" Value="SemiBold" />
            <contract99Present:Setter Property="Foreground" Value="Red" />
        </Style>
    </Page.Resources>
    <StackPanel Margin="24" Spacing="12">
        <TextBlock Style="{StaticResource ConditionalHeadingStyle}" Text="Conditional XAML" />

        <!--  Elements: the first and the last of these four are shown.  -->
        <contract7Present:TextBlock Text="Contract 7 is present." />
        <contract7NotPresent:TextBlock Text="Contract 7 is not present." />
        <contract99Present:TextBlock Text="Contract 99 is present." />
        <contract99NotPresent:TextBlock Text="Contract 99 is not present." />

        <!--  One property under two complementary conditions: both borders are green, whichever attribute comes first.  -->
        <Border
            Height="24"
            contract99NotPresent:Background="Green"
            contract99Present:Background="Red" />
        <Border
            Height="24"
            contract99Present:Background="Red"
            contract99NotPresent:Background="Green" />

        <!--  A custom condition: FeatureFlagCondition.Evaluate("NewExperience") is true, "LegacyMode" is false.  -->
        <newExperience:InfoBar
            Title="New experience"
            IsClosable="False"
            IsOpen="True"
            Message="Shown because the NewExperience flag is on."
            Severity="Success" />
        <legacyMode:InfoBar
            Title="Legacy mode"
            IsClosable="False"
            IsOpen="True"
            Message="Shown because the LegacyMode flag is on."
            Severity="Warning" />
        <Button legacyMode:Content="Open the classic editor" newExperience:Content="Open the new editor" />
    </StackPanel>
</Page>
