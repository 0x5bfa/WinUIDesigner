<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net472</TargetFramework>
		<AssemblyName>WinUIDesigner</AssemblyName>
		<RootNamespace>WinUIDesigner.Vsix</RootNamespace>
		<GeneratePkgDefFile>true</GeneratePkgDefFile>
		<GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
		<VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
		<VsixDeployOnDebug>true</VsixDeployOnDebug>
		<StartAction>Program</StartAction>
		<StartProgram>$(VsInstallRoot)\Common7\IDE\devenv.exe</StartProgram>
		<StartArguments>/rootsuffix Exp</StartArguments>
		<WinUISurfaceTargetFramework>net10.0-windows10.0.19041.0</WinUISurfaceTargetFramework>
		<WinUISurfaceOutputDir>$(MSBuildProjectDirectory)\..\WinUIDesigner.Surface\bin\$(Configuration)\$(WinUISurfaceTargetFramework)</WinUISurfaceOutputDir>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.9.820" PrivateAssets="all" />
		<PackageReference Include="MonoMod.RuntimeDetour" Version="25.3.4" />
		<PackageReference Include="System.Resources.Extensions" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectCapability Include="CreateVsixContainer" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="Microsoft.VisualStudio.Shell">
			<HintPath>$(VsInstallRoot)\Common7\IDE\PublicAssemblies\Microsoft.VisualStudio.Shell.15.0.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Microsoft.VisualStudio.Threading">
			<HintPath>$(VsInstallRoot)\Common7\IDE\PublicAssemblies\Microsoft.VisualStudio.Threading.17.x\Microsoft.VisualStudio.Threading.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Microsoft.VisualStudio.DesignTools.UwpSurfaceDesigner">
			<HintPath>$(VsInstallRoot)\Common7\IDE\PrivateAssemblies\Microsoft.VisualStudio.DesignTools.UwpSurfaceDesigner.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Microsoft.VisualStudio.DesignTools.Extensibility">
			<HintPath>$(VsInstallRoot)\Common7\IDE\PublicAssemblies\Microsoft.VisualStudio.DesignTools.Extensibility.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Microsoft.VisualStudio.Shell.Interop">
			<HintPath>$(VsInstallRoot)\Common7\IDE\PublicAssemblies\Microsoft.VisualStudio.Shell.Interop.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Microsoft.VisualStudio.Shell.Framework">
			<HintPath>$(VsInstallRoot)\Common7\IDE\PublicAssemblies\Microsoft.VisualStudio.Shell.Framework.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Microsoft.VisualStudio.Interop">
			<HintPath>$(VsInstallRoot)\Common7\IDE\PublicAssemblies\Microsoft.VisualStudio.Interop.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Microsoft.VisualStudio.DesignTools.UtilityBase">
			<HintPath>$(VsInstallRoot)\Common7\IDE\PrivateAssemblies\Microsoft.VisualStudio.DesignTools.UtilityBase.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Microsoft.VisualStudio.DesignTools.RuntimeHostBase">
			<HintPath>$(VsInstallRoot)\Common7\IDE\PrivateAssemblies\Microsoft.VisualStudio.DesignTools.RuntimeHostBase.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Microsoft.VisualStudio.DesignTools.RuntimeHost">
			<HintPath>$(VsInstallRoot)\Common7\IDE\PrivateAssemblies\Microsoft.VisualStudio.DesignTools.RuntimeHost.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Microsoft.VisualStudio.DesignTools.Markup">
			<HintPath>$(VsInstallRoot)\Common7\IDE\PrivateAssemblies\Microsoft.VisualStudio.DesignTools.Markup.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Microsoft.VisualStudio.DesignTools.DesignerHost">
			<HintPath>$(VsInstallRoot)\Common7\IDE\PrivateAssemblies\Microsoft.VisualStudio.DesignTools.DesignerHost.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Microsoft.VisualStudio.DesignTools.SurfaceDesigner">
			<HintPath>$(VsInstallRoot)\Common7\IDE\PrivateAssemblies\Microsoft.VisualStudio.DesignTools.SurfaceDesigner.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Microsoft.VisualStudio.DesignTools.XamlSurfaceDesigner">
			<HintPath>$(VsInstallRoot)\Common7\IDE\PrivateAssemblies\Microsoft.VisualStudio.DesignTools.XamlSurfaceDesigner.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Microsoft.VisualStudio.DesignTools.DesignerContract">
			<HintPath>$(VsInstallRoot)\Common7\IDE\PrivateAssemblies\Microsoft.VisualStudio.DesignTools.DesignerContract.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Microsoft.VisualStudio.DesignTools.DesignerContractBase">
			<HintPath>$(VsInstallRoot)\Common7\IDE\PrivateAssemblies\Microsoft.VisualStudio.DesignTools.DesignerContractBase.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Microsoft.VisualStudio.DesignTools.Utility">
			<HintPath>$(VsInstallRoot)\Common7\IDE\PrivateAssemblies\Microsoft.VisualStudio.DesignTools.Utility.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Microsoft.VisualStudio.DesignTools.XamlLanguageServiceBase">
			<HintPath>$(VsInstallRoot)\Common7\IDE\PrivateAssemblies\Microsoft.VisualStudio.DesignTools.XamlLanguageServiceBase.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Microsoft.VisualStudio.DesignTools.XamlDesignerHost">
			<HintPath>$(VsInstallRoot)\Common7\IDE\PrivateAssemblies\Microsoft.VisualStudio.DesignTools.XamlDesignerHost.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="PresentationCore" />
		<Reference Include="PresentationFramework" />
		<Reference Include="WindowsBase" />
		<Reference Include="System.Drawing" />
	</ItemGroup>


	<ItemGroup>
		<None Include="source.extension.vsixmanifest" />
		<EmbeddedResource Update="Resources\VSPackage.resx">
			<LogicalName>VSPackage.resources</LogicalName>
		</EmbeddedResource>
		<VSIXSourceItem Include="$(MSBuildProjectDirectory)\..\..\LICENSE">
			<TargetPath>LICENSE.txt</TargetPath>
		</VSIXSourceItem>
		<VSIXSourceItem Include="$(MSBuildProjectDirectory)\Resources\logo-90.png">
			<TargetPath>Images\WinUIDesignerIcon.png</TargetPath>
		</VSIXSourceItem>
		<VSIXSourceItem Include="$(MSBuildProjectDirectory)\Resources\preview.png">
			<TargetPath>Images\WinUIDesignerPreview.png</TargetPath>
		</VSIXSourceItem>
	</ItemGroup>

	<Target Name="StageWinUISurfacePayload" BeforeTargets="GetVsixSourceItems">
		<ItemGroup>
			<VSIXSourceItem Include="$(WinUISurfaceOutputDir)\**\*" Exclude="$(WinUISurfaceOutputDir)\**\*.pdb;$(WinUISurfaceOutputDir)\**\Microsoft.VisualStudio.*.dll">
				<VSIXSubPath>Surface\%(RecursiveDir)</VSIXSubPath>
			</VSIXSourceItem>
		</ItemGroup>
	</Target>
</Project>
