<Page
    x:Class="DesignerSmokeApp.ResourcePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DesignerSmokeApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.DataContext>
        <local:SmokeModel />
    </Page.DataContext>
    <StackPanel Margin="24" Spacing="16">
        <Button
            x:Name="StyledTarget"
            Content="Application resource and BasedOn"
            Style="{StaticResource DerivedButtonStyle}" />
        <TextBlock
            x:Name="BoundTarget"
            Foreground="{StaticResource AppTestBrush}"
            Text="{Binding Title}" />
        <local:ReferencedControl x:Name="CustomResourceTarget" Label="Custom dependency property" />
    </StackPanel>
</Page>
