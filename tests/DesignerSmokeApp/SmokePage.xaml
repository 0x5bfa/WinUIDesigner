<Page
    x:Class="DesignerSmokeApp.SmokePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DesignerSmokeApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <SolidColorBrush x:Key="TestBrush" Color="SteelBlue" />
    </Page.Resources>
    <Grid x:Name="RootGrid">
        <Canvas>
            <Button
                x:Name="MoveTarget"
                Canvas.Left="40"
                Canvas.Top="50"
                Width="160"
                Height="48"
                Content="Move and resize" />
            <Button
                Canvas.Left="40"
                Canvas.Top="120"
                Content="Unnamed first" />
            <Button
                Canvas.Left="40"
                Canvas.Top="180"
                Content="Unnamed second" />
            <local:ReferencedControl
                x:Name="CustomTarget"
                Canvas.Left="240"
                Canvas.Top="50" />
            <Border
                Canvas.Left="240"
                Canvas.Top="150"
                Width="100"
                Height="80"
                Background="{StaticResource TestBrush}" />
        </Canvas>
    </Grid>
</Page>
