<Project Sdk="MSTest.Sdk/4.4.1">

	<PropertyGroup>
		<TargetFramework>$(WinUIDesignerSurfaceTestsTargetFramework)</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<TestingExtensionsProfile>None</TestingExtensionsProfile>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="../../src/WinUIDesigner.Surface/Transport/MessageFrameReader.cs" Link="MessageFrameReader.cs" Visible="false" />
		<Compile Include="../../src/WinUIDesigner.Surface/Common/DispatcherOperation.cs" Link="DispatcherOperation.cs" Visible="false" />
		<Compile Include="../../src/WinUIDesigner.Surface/Runtime/RuntimeMemberResolver.cs" Link="RuntimeMemberResolver.cs" Visible="false" />
		<Compile Include="../../src/WinUIDesigner.Surface/Runtime/RuntimeTypeNameSerializer.cs" Link="RuntimeTypeNameSerializer.cs" Visible="false" />
		<Compile Include="../../src/WinUIDesigner.Surface/Common/DocumentConstructionException.cs" Link="DocumentConstructionException.cs" Visible="false" />
		<Compile Include="../../src/WinUIDesigner.Surface/Common/ObjectIdentityRegistry.cs" Link="ObjectIdentityRegistry.cs" Visible="false" />
		<Compile Include="../../src/WinUIDesigner.Surface/Common/DocumentScope.cs" Link="DocumentScope.cs" Visible="false" />
		<Compile Include="../../src/WinUIDesigner.Shared/Markup/**/*.cs" Link="Shared/Markup/%(RecursiveDir)%(Filename)%(Extension)" Visible="false" />
		<Compile Include="../../src/WinUIDesigner.Shared/Protocol/**/*.cs" Link="Shared/Protocol/%(RecursiveDir)%(Filename)%(Extension)" Visible="false" />
		<Compile Include="../../src/WinUIDesigner.Shared/DesignTime/**/*.cs" Link="Shared/DesignTime/%(RecursiveDir)%(Filename)%(Extension)" Visible="false" />
		<Compile Include="../../src/WinUIDesigner.Surface/Markup/**/*.cs" Link="Surface/Markup/%(RecursiveDir)%(Filename)%(Extension)" Visible="false" />
		<Compile Include="../../src/WinUIDesigner.Vsix/Platform/XamlConditionAnswers.cs" Link="Vsix/XamlConditionAnswers.cs" Visible="false" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="Microsoft.VisualStudio.DesignTools.RuntimeHostBase">
			<HintPath>$(VsInstallRoot)/Common7/IDE/PrivateAssemblies/Microsoft.VisualStudio.DesignTools.RuntimeHostBase.dll</HintPath>
		</Reference>
	</ItemGroup>

</Project>
