<Project Sdk="MSTest.Sdk/4.4.1">

	<PropertyGroup>
		<TargetFramework>net472</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<TestingExtensionsProfile>None</TestingExtensionsProfile>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="../../src/WinUIDesigner.Vsix/Toolbox/ToolboxItemData.cs" Link="ToolboxItemData.cs" Visible="false" />
		<Compile Include="../../src/WinUIDesigner.Vsix/Toolbox/ProvideStaticXamlToolboxItemsAttribute.cs" Link="ProvideStaticXamlToolboxItemsAttribute.cs" Visible="false" />
		<Compile Include="../../src/WinUIDesigner.Vsix/Toolbox/ProvideStaticWinUIToolboxItemsAttribute.cs" Link="ProvideStaticWinUIToolboxItemsAttribute.cs" Visible="false" />
		<Compile Include="../../src/WinUIDesigner.Vsix/Platform/XamlConditionAnswers.cs" Link="XamlConditionAnswers.cs" Visible="false" />
		<Compile Include="../../src/WinUIDesigner.Vsix/Platform/DesignTimeOptionsSettings.cs" Link="DesignTimeOptionsSettings.cs" Visible="false" />
		<Compile Include="../../src/WinUIDesigner.Vsix/Platform/ConditionalXamlSwitchRow.cs" Link="ConditionalXamlSwitchRow.cs" Visible="false" />
	</ItemGroup>

	<ItemGroup>
		<!-- The condition code is shared by both designer processes, so its tests run on both runtimes. -->
		<Compile Include="../WinUIDesigner.Surface.Tests/XamlConditionTests.cs" Link="Shared/XamlConditionTests.cs" Visible="false" />
		<Compile Include="../WinUIDesigner.Surface.Tests/XamlConditionServiceTests.cs" Link="Shared/XamlConditionServiceTests.cs" Visible="false" />
		<Compile Include="../WinUIDesigner.Surface.Tests/XamlConditionExchangeTests.cs" Link="Shared/XamlConditionExchangeTests.cs" Visible="false" />
		<Compile Include="../WinUIDesigner.Surface.Tests/XamlConditionProtocolTests.cs" Link="Shared/XamlConditionProtocolTests.cs" Visible="false" />
		<Compile Include="../WinUIDesigner.Surface.Tests/XamlConditionOverridesTests.cs" Link="Shared/XamlConditionOverridesTests.cs" Visible="false" />
		<Compile Include="../WinUIDesigner.Surface.Tests/XamlConditionSwitchesTests.cs" Link="Shared/XamlConditionSwitchesTests.cs" Visible="false" />
	</ItemGroup>

	<ItemGroup>
		<!-- Tells the tests where the Visual Studio they were built with is installed. -->
		<AssemblyMetadata Include="VsInstallRoot" Value="$(VsInstallRoot)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Mono.Cecil" Version="0.11.6" />
		<PackageReference Include="System.Diagnostics.DiagnosticSource" Version="9.0.11" />
		<PackageReference Include="System.Reflection.Metadata" Version="10.0.8" />
		<PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="PresentationFramework" />
		<Reference Include="PresentationCore" />
		<Reference Include="WindowsBase" />
		<Reference Include="Microsoft.VisualStudio.Shell.Framework">
			<HintPath>$(VsInstallRoot)/Common7/IDE/PublicAssemblies/Microsoft.VisualStudio.Shell.Framework.dll</HintPath>
		</Reference>
		<Reference Include="Microsoft.VisualStudio.Shell">
			<HintPath>$(VsInstallRoot)/Common7/IDE/PublicAssemblies/Microsoft.VisualStudio.Shell.15.0.dll</HintPath>
		</Reference>
		<Reference Include="Microsoft.VisualStudio.Interop">
			<HintPath>$(VsInstallRoot)/Common7/IDE/PublicAssemblies/Microsoft.VisualStudio.Interop.dll</HintPath>
		</Reference>
		<Reference Include="Microsoft.VisualStudio.DesignTools.Utility">
			<HintPath>$(VsInstallRoot)/Common7/IDE/PrivateAssemblies/Microsoft.VisualStudio.DesignTools.Utility.dll</HintPath>
		</Reference>
		<Reference Include="Microsoft.VisualStudio.DesignTools.UtilityBase">
			<HintPath>$(VsInstallRoot)/Common7/IDE/PrivateAssemblies/Microsoft.VisualStudio.DesignTools.UtilityBase.dll</HintPath>
		</Reference>
		<Reference Include="Microsoft.VisualStudio.DesignTools.XamlDesignerHost">
			<HintPath>$(VsInstallRoot)/Common7/IDE/PrivateAssemblies/Microsoft.VisualStudio.DesignTools.XamlDesignerHost.dll</HintPath>
		</Reference>
		<Reference Include="Microsoft.VisualStudio.DesignTools.RuntimeHostBase">
			<HintPath>$(VsInstallRoot)/Common7/IDE/PrivateAssemblies/Microsoft.VisualStudio.DesignTools.RuntimeHostBase.dll</HintPath>
		</Reference>
	</ItemGroup>

	<Import Project="..\..\src\WinUIDesigner.Shared\WinUIDesigner.Shared.projitems" Label="Shared" />

</Project>
